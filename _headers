# Cloudflare headers (https://developers.cloudflare.com/pages/configuration/headers/).
#
# Memofun is a fully static site with no API, no build step, and no
# third-party script of any kind — vanilla HTML/CSS/JS only. Decks are
# plain JSON fetched same-origin from decks/. That lets the CSP below be
# tight: no external script/connect hosts, no WASM allowance.
#   - style-src allows 'unsafe-inline' for the handful of inline
#     `style="..."` attributes used for small one-off layout tweaks.
#   - No inline <script>, no eval, no third-party origins anywhere.

# ---------------------------------------------------------------------------
# Security headers — applied to every response, including HTML.
# ---------------------------------------------------------------------------
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), midi=()
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Opener-Policy: same-origin
  Upgrade-Insecure-Requests: 1
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# ---------------------------------------------------------------------------
# Cache policy. The service worker (sw.js) owns the offline app-shell
# cache with its own VERSION-bump contract (see CLAUDE.md) — these HTTP
# cache headers are a second, independent layer for plain (non-PWA)
# visits and for Cloudflare's edge cache.
# ---------------------------------------------------------------------------
/sw.js
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/manifest.json
  Cache-Control: no-cache, must-revalidate
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=300
/assets/js/*
  Cache-Control: public, max-age=300
/decks/*
  Cache-Control: public, max-age=86400
